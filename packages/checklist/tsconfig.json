{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "preserve",
    "baseUrl": ".",
    "outDir": "./dist",
    "paths": {
      "@portal/ui": ["../ui/src/index.ts"],
      "@portal/ui/*": ["../ui/src/*"],
      "@portal/core": ["../core/src/index.ts"],
      "@portal/core/*": ["../core/src/*"],
      "@portal/shared": ["../shared/src/index.ts"],
      "@portal/shared/*": ["../shared/src/*"]
    }
  },
  "include": ["src"],
  "references": [
    { "path": "../shared" },
    { "path": "../ui" },
    { "path": "../core" }
  ]
}