{
  "name": "portal-conecta",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@11.0.8",
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "build": "pnpm --filter \"./packages/*\" --if-present build && pnpm --filter \"./apps/*\" build",
    "lint": "pnpm --recursive lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\"",
    "typecheck": "tsc --build",
    "sb:css": "node scripts/build-storybook-css.mjs",
    "storybook": "pnpm sb:css && storybook dev -p 6006",
    "build-storybook": "pnpm sb:css && storybook build",
    "sync:tokens": "tsx scripts/sync-tokens.ts"
  },
  "devDependencies": {
    "@fontsource/afacad": "^5.2.10",
    "@fontsource/inter": "^5.2.8",
    "@storybook/addon-a11y": "^8.0.0",
    "@storybook/addon-essentials": "^8.0.0",
    "@storybook/addon-interactions": "^8.0.0",
    "@storybook/nextjs": "^8.0.0",
    "@storybook/react": "^8.0.0",
    "@tailwindcss/postcss": "4.3.0",
    "@types/node": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^8.57.0",
    "postcss": "8.5.15",
    "prettier": "^3.0.0",
    "storybook": "^8.0.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.22.4",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=22.13",
    "pnpm": ">=11"
  },
  "pnpm": {
    "overrides": {
      "webpack": "5.101.2"
    }
  }
}
