{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "preserve",
    "baseUrl": ".",
    "plugins": [{ "name": "next" }],
    "paths": {
      "@portal/ui": ["../../packages/ui/src/index.ts"],
      "@portal/ui/*": ["../../packages/ui/src/*"],
      "@portal/core": ["../../packages/core/src/index.ts"],
      "@portal/core/*": ["../../packages/core/src/*"],
      "@portal/shared": ["../../packages/shared/src/index.ts"],
      "@portal/shared/*": ["../../packages/shared/src/*"],
      "@portal/comunicados": ["../../packages/comunicados/src/index.ts"],
      "@portal/comunicados/*": ["../../packages/comunicados/src/*"],
      "@portal/checklist": ["../../packages/checklist/src/index.ts"],
      "@portal/checklist/*": ["../../packages/checklist/src/*"],
      "@portal/mapa-salas": ["../../packages/mapa-salas/src/index.ts"],
      "@portal/mapa-salas/*": ["../../packages/mapa-salas/src/*"]
    }
  },
  "include": ["src", "next-env.d.ts", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
