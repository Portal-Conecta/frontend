# Variáveis do app Next (apps/root). O Next carrega .env a partir do diretório
# do app — copie este arquivo para `.env.local` para rodar localmente.
#
# EM CONTAINER (Docker/EC2): estes hosts NÃO são `localhost`. Na rede do Compose
# os serviços se enxergam por NOME — API_URL=http://core:8080 e
# API_GATEWAY_URL=http://api-gateway:8080. Os valores abaixo são só para dev local.
# O compose de deploy (portal-conecta/docker-compose.yml) já injeta os corretos.

# API_URL: base do core/auth usada SERVER-SIDE no login/refresh (Route Handler
# /api/auth/login). Privada — não exposta ao browser.
API_URL=http://localhost:8090

# API_GATEWAY_URL: borda HTTP única do Portal Conecta. O BFF de comunicados
# chama `/comunicados/**` aqui; o gateway remove o prefixo e roteia ao serviço.
# Docker Compose expõe o gateway em GATEWAY_PORT (padrão 8081).
API_GATEWAY_URL=http://localhost:8081

# COOKIE_SECURE: marca os cookies de sessão como Secure. Default (não setada):
# true em produção. Deixe "false" ao servir sob HTTP puro (ex.: EC2 sem TLS),
# senão o navegador descarta o cookie e o login não fecha.
# COOKIE_SECURE=false

# NEXT_PUBLIC_API_URL: base do back-end exposta ao CLIENT (uso futuro em
# chamadas diretas do browser).
NEXT_PUBLIC_API_URL=http://localhost:8090

# Ambiente da aplicação.
NEXT_PUBLIC_APP_ENV=development
