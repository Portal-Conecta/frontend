# Variáveis do app Next (apps/root). O Next carrega .env a partir do diretório
# do app — copie este arquivo para `.env.local` para rodar localmente.

# API_URL: base do back-end usada SERVER-SIDE (Route Handler /api/auth/login,
# authService). Privada — não exposta ao browser.
API_URL=http://localhost:8090

# COMUNICADOS_API_URL: base do back-end de comunicados usada SERVER-SIDE
# (Route Handlers /api/comunicados/*, postsService). Privada — não exposta ao
# browser. Serviço separado do core/auth.
COMUNICADOS_API_URL=http://localhost:8083

# NEXT_PUBLIC_API_URL: base do back-end exposta ao CLIENT (uso futuro em
# chamadas diretas do browser).
NEXT_PUBLIC_API_URL=http://localhost:8090

# Ambiente da aplicação.
NEXT_PUBLIC_APP_ENV=development
